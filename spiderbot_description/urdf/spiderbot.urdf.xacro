<?xml version="1.0"?>
<!--
  Spiderbot hexapod: primitive-geometry stand-in for the Hiwonder JetHexa (18 DOF).

  No vendor URDF/meshes are used. Every dimension below is an ESTIMATE, sized to
  roughly match JetHexa's published overall size (387 x 356 x 210 mm, legs included).
  Replace them with measured values once the real robot is available.

  Conventions (REP-103): base_link at the body centre, x forward, y left, z up.
  base_footprint is the root frame, on the ground directly below base_link when standing.
  Layout: rectangular body, two legs per side (front / middle / rear); front and
  rear legs are splayed 45 deg from the sides.

  Sensors (JetHexa Ultimate kit): laser_link is the lidar's scan centre on top of the
  body; camera_link is the depth camera on the front edge (x forward, tilted down), and
  camera_optical_frame is the same point in the optical convention (z forward, x right,
  y down) that its images use. Gazebo sensor settings are in spiderbot.gazebo.xacro.

  Masses are ESTIMATES (about 2.5 kg in total). Every part has inertia matching its
  visual, which Gazebo needs. Collision shapes are off by default (xacro arg
  collisions:=true adds them): the simulated robot is moved by setting its pose, not by
  physics, and in Gazebo 9.0 its own collision shapes can show up in its lidar scan.

  Per leg, <leg> = front_left | middle_left | rear_left | front_right | middle_right | rear_right:
    links:  <leg>_coxa_link -> <leg>_femur_link -> <leg>_tibia_link -> <leg>_foot_link
    joints: <leg>_coxa_joint, <leg>_femur_joint, <leg>_tibia_joint (revolute),
            <leg>_foot_joint (fixed, marks the foot tip)

  Zero pose is a standing pose: coxa and femur point straight out horizontally,
  tibia hangs straight down. Positive joint angles mean:
    coxa  - counter-clockwise seen from above (same axis on both sides)
    femur - leg lifts up
    tibia - foot swings outward, away from the body
-->
<robot name="spiderbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Body box (ESTIMATE) -->
  <xacro:property name="body_length" value="0.20"/>
  <xacro:property name="body_width" value="0.15"/>
  <xacro:property name="body_height" value="0.05"/>

  <!-- Leg segment lengths, joint axis to joint axis (ESTIMATE) -->
  <xacro:property name="coxa_length" value="0.045"/>
  <xacro:property name="femur_length" value="0.075"/>
  <xacro:property name="tibia_length" value="0.125"/>

  <!-- Joint limits are placeholders, not JetHexa servo specs. effort/velocity are
       required by URDF but unused by the display tools. -->
  <xacro:property name="coxa_limit" value="${pi/4}"/>
  <xacro:property name="femur_limit" value="${pi/2}"/>
  <xacro:property name="tibia_limit" value="${pi/2}"/>
  <xacro:property name="joint_effort" value="3.0"/>
  <xacro:property name="joint_velocity" value="5.0"/>

  <!-- Masses in kg (ESTIMATE). The body includes the Jetson, battery and electronics;
       each leg segment includes its servo. -->
  <xacro:property name="body_mass" value="1.2"/>
  <xacro:property name="coxa_mass" value="0.06"/>
  <xacro:property name="femur_mass" value="0.08"/>
  <xacro:property name="tibia_mass" value="0.04"/>

  <!-- Sensor mounts (ESTIMATE). The lidar's scan plane ends up about 19 cm above the dirt.
       The camera is tilted down so it sees the ground ahead as well as walls and piers. -->
  <xacro:property name="lidar_xyz" value="-0.02 0 0.065"/>
  <xacro:property name="camera_xyz" value="${body_length/2 + 0.0125} 0 ${body_height/2 + 0.0125}"/>
  <xacro:property name="camera_tilt" value="${10*pi/180}"/>

  <material name="body"><color rgba="0.25 0.25 0.25 1"/></material>
  <material name="heading"><color rgba="0.85 0.1 0.1 1"/></material>
  <material name="coxa"><color rgba="0.95 0.55 0.1 1"/></material>
  <material name="femur"><color rgba="0.75 0.75 0.75 1"/></material>
  <material name="tibia"><color rgba="0.15 0.4 0.85 1"/></material>
  <material name="sensor"><color rgba="0.1 0.1 0.1 1"/></material>

  <xacro:arg name="collisions" default="false"/>

  <!-- A part's visual plus solid-body inertia (and, with collisions:=true, a matching
       collision shape), centred at xyz -->
  <xacro:macro name="box_part" params="x y z xyz mass material">
    <visual>
      <origin xyz="${xyz}"/>
      <geometry><box size="${x} ${y} ${z}"/></geometry>
      <material name="${material}"/>
    </visual>
    <xacro:if value="$(arg collisions)">
      <collision>
        <origin xyz="${xyz}"/>
        <geometry><box size="${x} ${y} ${z}"/></geometry>
      </collision>
    </xacro:if>
    <inertial>
      <origin xyz="${xyz}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(y*y + z*z)/12}" ixy="0" ixz="0"
               iyy="${mass*(x*x + z*z)/12}" iyz="0" izz="${mass*(x*x + y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_part" params="radius length xyz mass material">
    <visual>
      <origin xyz="${xyz}"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      <material name="${material}"/>
    </visual>
    <xacro:if value="$(arg collisions)">
      <collision>
        <origin xyz="${xyz}"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
    </xacro:if>
    <inertial>
      <origin xyz="${xyz}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
               iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0" izz="${mass*radius*radius/2}"/>
    </inertial>
  </xacro:macro>

  <!-- Massless root on the ground, so KDL doesn't warn about a root link with inertia -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${tibia_length}"/>
  </joint>

  <link name="base_link">
    <xacro:box_part x="${body_length}" y="${body_width}" z="${body_height}" xyz="0 0 0"
                    mass="${body_mass}" material="body"/>
    <!-- Heading marker on the front edge, just behind the camera -->
    <visual>
      <origin xyz="${body_length/2 - 0.01} 0 ${body_height/2 + 0.01}"/>
      <geometry><box size="0.02 0.06 0.02"/></geometry>
      <material name="heading"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${lidar_xyz}"/>
  </joint>
  <link name="laser_link">
    <xacro:cylinder_part radius="0.035" length="0.03" xyz="0 0 0" mass="0.15" material="sensor"/>
    <!-- Stand between the body and the lidar puck -->
    <visual>
      <origin xyz="0 0 -0.0275"/>
      <geometry><cylinder radius="0.02" length="0.025"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_xyz}" rpy="0 ${camera_tilt} 0"/>
  </joint>
  <link name="camera_link">
    <xacro:box_part x="0.025" y="0.09" z="0.025" xyz="0 0 0" mass="0.1" material="sensor"/>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_optical_frame"/>

  <!-- One 3-DOF leg mounted on base_link at (x, y), with its local x axis rotated
       by yaw so that it points away from the body. -->
  <xacro:macro name="leg" params="prefix x y yaw">
    <joint name="${prefix}_coxa_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_coxa_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 ${yaw}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-coxa_limit}" upper="${coxa_limit}" effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <link name="${prefix}_coxa_link">
      <xacro:box_part x="${coxa_length}" y="0.03" z="0.025" xyz="${coxa_length/2} 0 0"
                      mass="${coxa_mass}" material="coxa"/>
    </link>

    <joint name="${prefix}_femur_joint" type="revolute">
      <parent link="${prefix}_coxa_link"/>
      <child link="${prefix}_femur_link"/>
      <origin xyz="${coxa_length} 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${-femur_limit}" upper="${femur_limit}" effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <link name="${prefix}_femur_link">
      <xacro:box_part x="${femur_length}" y="0.02" z="0.02" xyz="${femur_length/2} 0 0"
                      mass="${femur_mass}" material="femur"/>
    </link>

    <joint name="${prefix}_tibia_joint" type="revolute">
      <parent link="${prefix}_femur_link"/>
      <child link="${prefix}_tibia_link"/>
      <origin xyz="${femur_length} 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${-tibia_limit}" upper="${tibia_limit}" effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <link name="${prefix}_tibia_link">
      <!-- Cylinders are aligned with z, so this hangs straight down at zero -->
      <xacro:cylinder_part radius="0.008" length="${tibia_length}" xyz="0 0 ${-tibia_length/2}"
                           mass="${tibia_mass}" material="tibia"/>
    </link>

    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_tibia_link"/>
      <child link="${prefix}_foot_link"/>
      <origin xyz="0 0 ${-tibia_length}"/>
    </joint>
    <link name="${prefix}_foot_link"/>

    <xacro:leg_gazebo prefix="${prefix}"/>
  </xacro:macro>

  <xacro:include filename="$(find spiderbot_description)/urdf/spiderbot.gazebo.xacro"/>

  <xacro:leg prefix="front_left"   x="${body_length/2}"  y="${body_width/2}"  yaw="${pi/4}"/>
  <xacro:leg prefix="middle_left"  x="0"                 y="${body_width/2}"  yaw="${pi/2}"/>
  <xacro:leg prefix="rear_left"    x="${-body_length/2}" y="${body_width/2}"  yaw="${3*pi/4}"/>
  <xacro:leg prefix="front_right"  x="${body_length/2}"  y="${-body_width/2}" yaw="${-pi/4}"/>
  <xacro:leg prefix="middle_right" x="0"                 y="${-body_width/2}" yaw="${-pi/2}"/>
  <xacro:leg prefix="rear_right"   x="${-body_length/2}" y="${-body_width/2}" yaw="${-3*pi/4}"/>

</robot>
