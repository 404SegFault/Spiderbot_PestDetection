<?xml version="1.0"?>
<!--
  Gazebo-only parts of the Spiderbot model: simulation settings and sensor plugins.
  robot_state_publisher and Foxglove ignore these. Sensor specs follow the JetHexa
  Ultimate kit (YDLIDAR G4 lidar, Orbbec Astra-class depth camera); check them against
  the real hardware when it arrives.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Kinematic links: gravity and contacts never move the robot or its legs. The walking
       node places the whole model each tick instead, so the legs don't need simulated
       motors. (Not <static>: Gazebo doesn't send a moved static model's new pose to its
       renderer, so the camera would stay behind while the lidar followed.) -->
  <!-- (Not named "kinematic": Melodic's xacro would treat the <kinematic> tag below as a
       call to it.) -->
  <xacro:macro name="kinematic_link" params="link">
    <gazebo reference="${link}">
      <kinematic>true</kinematic>
    </gazebo>
  </xacro:macro>

  <!-- Gazebo ignores the colours in the URDF, so it gets its own -->
  <xacro:macro name="gazebo_color" params="link material">
    <gazebo reference="${link}">
      <material>${material}</material>
    </gazebo>
  </xacro:macro>

  <!-- base_footprint is the Gazebo link that base_link and the sensor links merge into -->
  <xacro:kinematic_link link="base_footprint"/>
  <xacro:gazebo_color link="base_link" material="Gazebo/DarkGrey"/>
  <xacro:gazebo_color link="laser_link" material="Gazebo/Black"/>
  <xacro:gazebo_color link="camera_link" material="Gazebo/Black"/>

  <!-- Called by the leg macro in spiderbot.urdf.xacro -->
  <xacro:macro name="leg_gazebo" params="prefix">
    <xacro:kinematic_link link="${prefix}_coxa_link"/>
    <xacro:kinematic_link link="${prefix}_femur_link"/>
    <xacro:kinematic_link link="${prefix}_tibia_link"/>
    <xacro:gazebo_color link="${prefix}_coxa_link" material="Gazebo/Orange"/>
    <xacro:gazebo_color link="${prefix}_femur_link" material="Gazebo/Grey"/>
    <xacro:gazebo_color link="${prefix}_tibia_link" material="Gazebo/Blue"/>
  </xacro:macro>

  <!-- YDLIDAR G4: 360 deg, 0.12-16 m, 5-12 Hz. 720 samples (0.5 deg) keeps the CPU load low. -->
  <gazebo reference="laser_link">
    <sensor type="ray" name="lidar">
      <update_rate>7</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2*pi/720}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>16.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_laser.so">
        <topicName>scan</topicName>
        <frameName>laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Astra-class depth camera: 640x480 colour and depth, 58 deg horizontal field of view,
       depth only between 0.6 and 8 m like the real sensor. The colour image has no such
       limit (2 cm near clip), so close-up inspection still works. Rendering needs an X
       display, so on the headless VM Gazebo runs under xvfb-run.
       Gazebo pauses camera sensors that have no subscribers, and the first message after
       subscribing is the last frame from before the pause; later ones are live. -->
  <gazebo reference="camera_link">
    <sensor type="depth" name="depth_camera">
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>${58*pi/180}</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>10</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_openni_kinect.so">
        <cameraName>camera</cameraName>
        <imageTopicName>rgb/image_raw</imageTopicName>
        <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>depth/points</pointCloudTopicName>
        <frameName>camera_optical_frame</frameName>
        <pointCloudCutoff>0.6</pointCloudCutoff>
        <pointCloudCutoffMax>8.0</pointCloudCutoffMax>
      </plugin>
    </sensor>
  </gazebo>

</robot>
